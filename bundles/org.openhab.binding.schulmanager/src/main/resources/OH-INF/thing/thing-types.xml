<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="schulmanager"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<!-- ============================================================ account -->
	<bridge-type id="account">
		<label>Schulmanager Account</label>
		<description>Login to Schulmanager Online (parent or student account, also with several schools)</description>
		<semantic-equipment-tag>WebService</semantic-equipment-tag>
		<channels>
			<channel id="lettersUnread" typeId="count">
				<label>Unread Parent Letters</label>
			</channel>
			<channel id="lettersList" typeId="text">
				<label>Unread Parent Letters (Titles)</label>
			</channel>
			<channel id="lettersWidget" typeId="widget">
				<label>Parent Letters for Widget</label>
				<description>Latest parent letters including text (JSON) for the widget sm_elternbriefe. Read only, never marks a
					letter as read.</description>
			</channel>
			<channel id="messagesUnread" typeId="count">
				<label>Unread Messages</label>
			</channel>
			<channel id="lastUpdate" typeId="datetime">
				<label>Last Update</label>
			</channel>
		</channels>
		<config-description>
			<parameter-group name="login">
				<label>Login</label>
			</parameter-group>
			<parameter-group name="data">
				<label>Data</label>
			</parameter-group>
			<parameter name="username" type="text" required="true" groupName="login">
				<context>email</context>
				<label>E-Mail / Username</label>
				<description>Credentials as used in the Schulmanager app</description>
			</parameter>
			<parameter name="password" type="text" required="true" groupName="login">
				<context>password</context>
				<label>Password</label>
			</parameter>
			<parameter name="twoFactorCode" type="text" groupName="login">
				<label>Two-Factor Code</label>
				<description>Only for accounts with two-factor login and only once: enter the current code of the authenticator
					app (or from the e-mail) when the bridge asks for it. Like the app, the binding then remembers a device and no
					longer needs the code.</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="15" max="1440" unit="min" groupName="data">
				<label>Refresh Interval</label>
				<description>Minutes between two updates (at least 15)</description>
				<default>60</default>
			</parameter>
			<parameter name="scheduleWeeks" type="integer" min="1" max="3" groupName="data">
				<label>Timetable Weeks</label>
				<description>Current week plus following weeks (1-3); on weekends one more week is loaded</description>
				<default>2</default>
			</parameter>
			<parameter name="teacherDisplay" type="text" groupName="data">
				<label>Show Teachers As</label>
				<description>Display in the timetable and the text channels. The details always show the full name with
					abbreviation (if the school provides names).</description>
				<options>
					<option value="lastname">Last name</option>
					<option value="name">First and last name</option>
					<option value="abbreviation">Abbreviation</option>
				</options>
				<limitToOptions>true</limitToOptions>
				<default>lastname</default>
			</parameter>
			<parameter name="subjectDisplay" type="text" groupName="data">
				<label>Show Subjects As</label>
				<description>Display in the timetable and the text channels. The details always show the full subject name.</description>
				<options>
					<option value="name">Subject name (e.g. Geographie)</option>
					<option value="abbreviation">Abbreviation (e.g. Geo)</option>
				</options>
				<limitToOptions>true</limitToOptions>
				<default>name</default>
			</parameter>
			<parameter name="subjectNames" type="text" groupName="data">
				<label>Custom Subject Names</label>
				<description>Custom display per subject, e.g. "Ev=Religion, Swd=Sport, Sw=Sport". The key is the abbreviation or
					the official subject name. Applies to timetable, exams and homework and overrides "Show Subjects As". The
					details still show the official name.</description>
			</parameter>
			<parameter name="lettersLoadUnread" type="boolean" groupName="data">
				<label>Load Text of Unread Letters</label>
				<description>Also loads the text of letters that are still unread. Off as long as it is not confirmed that
					loading does not mark a letter as read in Schulmanager. Read letters are always loaded.</description>
				<default>false</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="examDaysAhead" type="integer" min="7" max="365" unit="d" groupName="data">
				<label>Exam Preview</label>
				<description>Days ahead for exams, tests and school events</description>
				<default>180</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</bridge-type>

	<!-- ============================================================ student -->
	<thing-type id="student">
		<supported-bridge-type-refs>
			<bridge-type-ref id="account"/>
		</supported-bridge-type-refs>
		<label>Schulmanager Student</label>
		<description>Timetable, exams, school events and homework of one child</description>
		<semantic-equipment-tag>WebService</semantic-equipment-tag>
		<channel-groups>
			<channel-group id="schedule" typeId="schedule"/>
			<channel-group id="exams" typeId="exams"/>
			<channel-group id="homework" typeId="homework"/>
			<channel-group id="info" typeId="info"/>
		</channel-groups>
		<properties>
			<property name="name"/>
		</properties>
		<representation-property>studentId</representation-property>
		<config-description>
			<parameter name="studentId" type="text" required="true">
				<label>Student ID</label>
				<description>Schulmanager ID of the child; listed in the properties (students) of the account bridge</description>
			</parameter>
		</config-description>
	</thing-type>

	<!-- ============================================================ groups -->
	<channel-group-type id="schedule">
		<label>Timetable</label>
		<channels>
			<channel id="today" typeId="text">
				<label>Timetable Today</label>
			</channel>
			<channel id="tomorrow" typeId="text">
				<label>Timetable Tomorrow</label>
			</channel>
			<channel id="nextDay" typeId="text">
				<label>Next School Day</label>
				<description>Timetable of the next day with lessons (e.g. Monday when it is Friday)</description>
			</channel>
			<channel id="nextDayDate" typeId="date">
				<label>Date of Next School Day</label>
			</channel>
			<channel id="currentLesson" typeId="text">
				<label>Current Lesson</label>
			</channel>
			<channel id="nextLesson" typeId="text">
				<label>Next Lesson</label>
			</channel>
			<channel id="firstLessonToday" typeId="datetime">
				<label>First Lesson Today</label>
			</channel>
			<channel id="lastLessonToday" typeId="datetime">
				<label>End of Lessons Today</label>
			</channel>
			<channel id="firstLessonNextDay" typeId="datetime">
				<label>First Lesson Next School Day</label>
			</channel>
			<channel id="changesToday" typeId="count">
				<label>Changes Today</label>
			</channel>
			<channel id="changesTomorrow" typeId="count">
				<label>Changes Tomorrow</label>
			</channel>
			<channel id="changesSummary" typeId="text">
				<label>Changes (Text)</label>
				<description>Substitutions, cancellations and room changes for today and tomorrow</description>
			</channel>
			<channel id="json" typeId="json">
				<label>Timetable (JSON)</label>
			</channel>
			<channel id="widget" typeId="widget">
				<label>Timetable for Widget</label>
			</channel>
			<channel id="changed" typeId="changed-trigger">
				<label>Timetable Changed</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="exams">
		<label>Exams &amp; Events</label>
		<channels>
			<channel id="next" typeId="text">
				<label>Next Exam</label>
			</channel>
			<channel id="nextDate" typeId="datetime">
				<label>Date of Next Exam</label>
			</channel>
			<channel id="daysUntilNext" typeId="count">
				<label>Days Until Next Exam</label>
			</channel>
			<channel id="countNext14Days" typeId="count">
				<label>Exams in the Next 14 Days</label>
			</channel>
			<channel id="list" typeId="text">
				<label>Upcoming Exams</label>
			</channel>
			<channel id="nextSchoolEvent" typeId="text">
				<label>Next School Event</label>
			</channel>
			<channel id="nextSchoolEventDate" typeId="datetime">
				<label>Date of Next School Event</label>
			</channel>
			<channel id="json" typeId="json">
				<label>Exams (JSON)</label>
			</channel>
			<channel id="widget" typeId="widget">
				<label>Exams for Widget</label>
			</channel>
			<channel id="new" typeId="text-trigger">
				<label>New Exam Added</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="homework">
		<label>Homework</label>
		<channels>
			<channel id="latest" typeId="text">
				<label>Latest Homework</label>
			</channel>
			<channel id="latestDate" typeId="date">
				<label>Date of Latest Homework</label>
			</channel>
			<channel id="countRecent" typeId="count">
				<label>Homework Last 7 Days</label>
			</channel>
			<channel id="list" typeId="text">
				<label>Homework Last 14 Days</label>
			</channel>
			<channel id="json" typeId="json">
				<label>Homework (JSON)</label>
			</channel>
			<channel id="widget" typeId="widget">
				<label>Homework for Widget</label>
			</channel>
			<channel id="new" typeId="text-trigger">
				<label>New Homework</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="info">
		<label>Info</label>
		<channels>
			<channel id="school" typeId="text">
				<label>School</label>
			</channel>
			<channel id="lastUpdate" typeId="datetime">
				<label>Last Update</label>
			</channel>
		</channels>
	</channel-group-type>

	<!-- ============================================================ channel types -->
	<channel-type id="text">
		<item-type>String</item-type>
		<label>Text</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="count">
		<item-type>Number</item-type>
		<label>Count</label>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="datetime">
		<item-type>DateTime</item-type>
		<label>Date and Time</label>
		<state readOnly="true" pattern="%1$tY-%1$tm-%1$td %1$tH:%1$tM"/>
	</channel-type>

	<channel-type id="date">
		<item-type>DateTime</item-type>
		<label>Date</label>
		<state readOnly="true" pattern="%1$ta %1$tY-%1$tm-%1$td"/>
	</channel-type>

	<channel-type id="json" advanced="true">
		<item-type>String</item-type>
		<label>JSON</label>
		<description>Structured data for own widgets or rules</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="widget">
		<item-type>String</item-type>
		<label>Widget Data</label>
		<description>Prepared data (JSON) for the Schulmanager Main UI widgets; do not persist</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="changed-trigger">
		<kind>trigger</kind>
		<label>Changed</label>
		<description>Fires CHANGED when substitutions, cancellations or room changes from today on change</description>
		<event>
			<options>
				<option value="CHANGED">Changed</option>
			</options>
		</event>
	</channel-type>

	<channel-type id="text-trigger">
		<kind>trigger</kind>
		<label>New Entry</label>
		<description>Fires with the text of the new entry (not on the first update)</description>
	</channel-type>

</thing:thing-descriptions>
